{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "support": {
      "presence": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('members').child(auth.uid).val() === true || newData.child('members').child(auth.uid).val() === true)",
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('admins').child(auth.uid).val() === true || !data.exists())"
          }
        },
        "meta": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.parent().child('members').child(auth.uid).val() === true || newData.parent().child('members').child(auth.uid).val() === true)"
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.parent().parent().child('members').child(auth.uid).val() === true && newData.child('uid').val() === auth.uid))"
          }
        }
      }
    }
  }
}
